      {
        "name": "Handmade Focus",
        "category": "Handmade",
        "settings": {
          "placeholder_text": "Search handmade...",
          "button_icon_class": "fa fa-hand-paper",
          "show_categories": true,
          "category_1": "Handmade",
          "category_1_count": "7",
          "category_2": "Art",
          "category_2_count": "3",
          "category_3": "Decor",
          "category_3_count": "4",
          "category_4": "Jewelry",
          "category_4_count": "2",
          "category_5": "Woodwork",
          "category_5_count": "1"
        }
      }
    ]
  }
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('search-input');
    var searchResults = document.getElementById('search-results');
  
    searchInput.addEventListener('input', function() {
      var query = searchInput.value.trim();
      if (query.length > 0) {
        fetchSearchResults(query);
        searchResults.style.display = 'block'; // Show results container
      } else {
        searchResults.style.display = 'none'; // Hide if input is empty
      }
    });
  
    // Handle click outside to close results
    document.addEventListener('click', function(event) {
      var isClickInsideSearch = searchInput.contains(event.target) || searchResults.contains(event.target);
      if (!isClickInsideSearch) {
        searchResults.style.display = 'none'; // Hide results container
      }
    });
  
    // Prevent closing results when clicking inside the results container
    searchResults.addEventListener('click', function(event) {
      event.stopPropagation(); // Prevent the click event from bubbling up
    });
  
    // Fetch search results function
    function fetchSearchResults(query) {
      fetch(`/search/suggest.json?q=${query}&resources[type]=article&resources[options][unavailable_products]=last`)
        .then(response => response.json())
        .then(data => {
          displaySearchResults(data.resources.results.articles);
        })
        .catch(error => console.error('Error fetching search results:', error));
    }
  
    // Display search results function
    function displaySearchResults(articles) {
      var resultsContainer = document.getElementById('search-results');
      resultsContainer.innerHTML = '';
  
      if (articles.length === 0) {
        resultsContainer.innerHTML = '<p>No results found.</p>';
        return;
      }
  
      articles.forEach(article => {
        var articleLink = document.createElement('a');
        articleLink.href = article.url;
        articleLink.textContent = article.title;
        resultsContainer.appendChild(articleLink);
      });
    }
  });
</script>