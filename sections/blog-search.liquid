        "default": true
      },
      {
        "type": "text",
        "id": "category_1",
        "label": "Category 1",
        "default": "Crafts"
      },
      {
        "type": "text",
        "id": "category_1_count",
        "label": "Category 1 Count",
        "default": "2"
      },
      {
        "type": "text",
        "id": "category_2",
        "label": "Category 2",
        "default": "8"
      },
      {
        "type": "text",
        "id": "category_2_count",
        "label": "Category 2 Count",
        "default": "8"
      },
      {
        "type": "text",
        "id": "category_3",
        "label": "Category 3",
        "default": "Handmade"
      },
      {
        "type": "text",
        "id": "category_3_count",
        "label": "Category 3 Count",
        "default": "7"
      },
      {
        "type": "text",
        "id": "category_4",
        "label": "Category 4",
        "default": "Interior"
      },
      {
        "type": "text",
        "id": "category_4_count",
        "label": "Category 4 Count",
        "default": "1"
      },
      {
        "type": "text",
        "id": "category_5",
        "label": "Category 5",
        "default": "Wood"
      },
      {
        "type": "text",
        "id": "category_5_count",
        "label": "Category 5 Count",
        "default": "6"
      },
      {
        "type": "inline_richtext",
        "id": "titlename",
        "default": "Recent Posts",
        "label": "Main Heading"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Slideshow Title"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top Padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 100
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom Padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      }
    ],
    "max_blocks": 5,
    "blocks": [
      {
        "type": "article",
        "name": "Article Block 1",
        "settings": [
          {
            "type": "article",
            "id": "article",
            "label": "Select Article"
          }
        ]
      },

      {
        "type": "article_row",
        "name": "Article Row Block",
        "settings": [
          {
            "type": "article",
            "id": "article",
            "label": "Select Article"
          }
        ]
      }
    ],
    "presets": [
