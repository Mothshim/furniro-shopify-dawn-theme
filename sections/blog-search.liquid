<style>
  .search-container {
    position: relative;
    width: 100%;
    max-width: 300px;
  }
  .blog-search-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  #search-input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  #search-button {
    position: absolute;
    right: 10px;
    top: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  #search-results {
    position: absolute;
    top: 100%;
    /* Position below the input */
    left: 0;
    width: 100%;
    max-height: 200px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #ccc;
    border-top: none;
    display: none;
    /* Hide by default */
    z-index: 1000;
    /* Ensure it's above other elements */
  }

  #search-results a {
    display: block;
    padding: 10px;
    text-decoration: none;
    color: #333;
  }

  #search-results a:hover {
    background: #f5f5f5;
  }
  .blog-search-container .categories ul {
    list-style: none;
    display: contents;
  }
  .blog-search-container .categories ul li {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .blog-search-container .categories h2 {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-search-container {
    position: absolute;
    top: 510px;
    right: 130px;
    width: 25%;
  }
  :root {
    --fixed-height: 62px;
    /* Fixed height */
    --remaining-height: calc(100% - var(--fixed-height));
    /* Calculate remaining height */
    --calculated-height: calc(var(--remaining-height) * 33.33 / 100);
    /* Calculate height */
  }

  .ak__card-list {
    height: 100%;
    /* Set height */
  }

  .ak__blog__maincontainer {
    width: 100%;
  }

  .multi-row {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    height: var(--calculated-height);
    padding-bottom: 20px;
  }

  .ak__card-list {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .ak__card-list .ak_custom_blog_v-article .article-card > .card__inner {
    width: 180px;
  }

  .ak__card-list .ak__ep__heading {
    align-items: center;
    justify-content: center;
    display: flex;
    padding: 2rem 0;
    font-size: 1.8rem;
    line-height: 2.1rem;
    text-transform: uppercase;
    font-family: Montserrat
    , sans-serif;
    font-weight: 700;
    background: white;
    color: black;
  }
  .multi-row .card:not(.ratio) {
    display: flex;
    flex-direction: row;
    /* border-top: 0.1rem solid rgb(187, 188, 188); */
  }

  .multi-row .ak__subheading {
    display: none;
  }


  .ak__card-list .ak_custom_blog_v-article .article-card > .card__inner {
    width: 180px;
  }


  .ak__card-list .ak_custom_blog_v-article .article-card > .card__content {
    padding: 15px 20px;
    display: flex;
    align-items: center;
  }
  .ak__card-list .ak_custom_blog_v-article .article-card > .card__content .card__information {
    padding: 0;
  }

  .ak__card-list .ak_custom_blog_v-article .article-card > .card__content .card__information .card__heading {
    font-size: 14px;
    line-height: 18px;
    height: 36px;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    text-transform: uppercase;
  }

  .ak__card-list .ak_custom_blog_v-article .article-card > .card__content .card__information .article-card__excerpt {
    font-size: 14px;
    line-height: 21px;
    height: 42px;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    margin: 0;
  }
  .ak__card-list .ak_custom_blog_v-article .article-card > .card__content .card__information .ak__subheading__article {
    font-size: 14px;
    line-height: 19px;
    width: 100%;
    text-decoration: underline;
    font-weight: 700;
  }
  @media (max-width: 990px) {
    .blog-search-container .search-container {
      display: none;
    }
    .blog-search-container .categories {
      display: none;
    }
    .blog-search-container .section-outer-container {
      padding: 0;
    }
    .blog-search-container {
      position: unset;
      width: 100%;
    }
  }
</style>

<div class=" blog-search-container">

  <div class="search-container">
    <input
      type="text"
      id="search-input"
      placeholder="{{ section.settings.placeholder_text }}">
    <button id="search-button">
      <i class="{{ section.settings.button_icon_class }}"></i>
    </button>
    <div id="search-results"></div>
  </div>

  {% if section.settings.show_categories %}
    <div class="categories">
      <h2>Categories</h2>
      <ul>
        <li>{{ section.settings.category_1 }}
          <span>{{ section.settings.category_1_count }}</span>
        </li>
        <li>{{ section.settings.category_2 }}
          <span>{{ section.settings.category_2_count }}</span>
        </li>
        <li>{{ section.settings.category_3 }}
          <span>{{ section.settings.category_3_count }}</span>
        </li>
        <li>{{ section.settings.category_4 }}
          <span>{{ section.settings.category_4_count }}</span>
        </li>
        <li>{{ section.settings.category_5 }}
          <span>{{ section.settings.category_5_count }}</span>
        </li>
      </ul>
    </div>
  {% endif %}

  <div class="section-outer-container" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};">
    <div class="ak__blog__maincontainer">
      <div class="blog-articles">
        {% for block in section.blocks %}
          {% if block.type == 'article' %}
            {% render 'article-card'
              ,
 blog: section.settings.blog
              ,
 article: block.settings.article
              ,
 media_aspect_ratio: 1.33
              ,
 show_image: true
              ,
 show_date: true
              ,
 show_author: true
              ,
 show_excerpt: true
              ,
 show_additional_text: true
              ,
 show_article_text: false
            %}
          {% endif %}
        {% endfor %}

        <div class="ak__card-list">
          <div class="ak__ep__heading">
            {{ section.settings.titlename }}
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'article_row' %}
              <div class="multi-row ak_custom_blog_v-article">
                {% render 'article-card'
                  ,
 blog: section.settings.blog
                  ,
 article: block.settings.article
                  ,
 media_aspect_ratio: 1.00
                  ,
 show_image: true
                  ,
 show_excerpt: false
                  ,
 show_author: false
                  ,
 show_date: true 
                  ,
 show_additional_text: false
                  ,
 show_article_text: false
                %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
