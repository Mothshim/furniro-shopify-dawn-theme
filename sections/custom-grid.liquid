{%- style -%}
  .custom-grid-section.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 20px;
    padding-right: 20px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .custom-grid-section.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .paragraph-container p {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 20px;
  }

  .heading-container h2 {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .image-grid-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ff__col__right,
  .ff__col__left {
    width: 40%;
  }

  .ff__col__center {
    width: 20%;
  }

  .image-grid-container .image-row--1 {
    text-align: left;
  }

  .image-grid-container .image-row--2 {
    text-align: right;
  }

  .image-grid-container img {
    max-width: 100%;
    height: auto;
  }

  .custom-grid-section .grid-text-content {
    text-align: center;
  }

  @media (max-width: 990px) {
    .ff__col__right,
    .ff__col__center,
    .ff__col__left {
      display: flex;
    }
  }
{%- endstyle -%}

<div class="custom-grid-section section-{{ section.id }}-padding page-width">
  <div class="grid-text-content">
    <div class="paragraph-container">
      <p>{{ section.settings.paragraph_text }}</p>
    </div>

    <div class="heading-container">
      <h2>{{ section.settings.heading_text }}</h2>
    </div>
  </div>

  <div class="image-grid-container">
    <div class="ff__col__right">
      <div class="image-row--1">
        <a href="{{ section.settings.link_1 }}">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_1.alt }}
          {%- endif -%}
        </a>
        <a href="{{ section.settings.link_2 }}">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_2.alt }}
          {%- endif -%}
        </a>
      </div>
      <div class="image-row--1">
        <a href="{{ section.settings.link_3 }}">
          {%- if section.settings.image_3 -%}
            {{ section.settings.image_3 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_3.alt }}
          {%- endif -%}
        </a>
        <a href="{{ section.settings.link_4 }}">
          {%- if section.settings.image_4 -%}
            {{ section.settings.image_4 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_4.alt }}
          {%- endif -%}
        </a>
      </div>
    </div>
    <div class="ff__col__center">
      <a href="{{ section.settings.link_center }}">
        {%- if section.settings.image_center -%}
          {{ section.settings.image_center | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_center.alt }}
        {%- endif -%}
      </a>
    </div>
    <div class="ff__col__left">
      <div class="image-row--2">
        <a href="{{ section.settings.link_5 }}">
          {%- if section.settings.image_5 -%}
            {{ section.settings.image_5 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_5.alt }}
          {%- endif -%}
        </a>
        <a href="{{ section.settings.link_6 }}">
          {%- if section.settings.image_6 -%}
            {{ section.settings.image_6 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_6.alt }}
          {%- endif -%}
        </a>
      </div>
      <div class="image-row--2">
        <a href="{{ section.settings.link_7 }}">
          {%- if section.settings.image_7 -%}
            {{ section.settings.image_7 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_7.alt }}
          {%- endif -%}
        </a>
        <a href="{{ section.settings.link_8 }}">
          {%- if section.settings.image_8 -%}
            {{ section.settings.image_8 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: section.settings.image_8.alt }}
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>
</div>

