<style>
  .tabs {
    overflow: hidden;
    text-align: center;
  }
  .tabs button {
    background-color: inherit;
    flex: 1;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 14px 16px;
    transition: 0.3s;
    color: gray;
    font-size: 24px;
    font-weight: 500;
  }
  .tabs button.active {
    color: black;
  }
  .tabcontent {
    display: none;
    padding: 6px 12px;
    border-top: none;
  }
  .tabcontent .product-des-img {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    flex-wrap: wrap;
  }
  .product-des-img img {
    width: 48%;
  }
  @media (max-width: 990px) {
    .tabs button {
      font-size: 15px;
      padding: 5px 8px;

    }
  }

</style>

<div class="custom-tabs page-width">
  <div class="tabs">
    <button
      class="tablinks"
      onclick="openTab(event, 'Description')"
      id="defaultOpen">Description</button>
    <button class="tablinks" onclick="openTab(event, 'AdditionalInformation')">Additional Information</button>
    <button class="tablinks" onclick="openTab(event, 'Reviews')">Reviews [5]</button>
  </div>

  <div id="Description" class="tabcontent">
    {{ product.description }}
    <div class="product-des-img">
      {% if product.metafields.custom.product_description_images %}
        {% assign images = product.metafields.custom.product_description_images.value %}
        {% for image in images %}
          {{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 48vw, 100vw', alt: product.title }}
        {% endfor %}
      {% elsif product.featured_image %}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 48vw, 100vw', alt: product.title }}
      {% endif %}
    </div>
  </div>

  <div id="AdditionalInformation" class="tabcontent">
    {{ section.settings.additional_information }}
  </div>

  <div id="Reviews" class="tabcontent">
    {{ section.settings.reviews }}
  </div>

</div>

{% schema %}
  {
    "name": "Custom Tabs",
    "settings": [
      {
        "type": "richtext",
        "id": "additional_information",
        "label": "Additional Information",
        "default": "<p>Add additional information here.</p>"
      },
      {
        "type": "richtext",
        "id": "reviews",
        "label": "Reviews",
        "default": "<p>Add reviews here.</p>"
      }
    ],
    "presets": [
      {
        "name": "Custom Tabs"
      }
    ]
  }
{% endschema %}


<script>
  function openTab(evt, tabName) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName("tabcontent");
    for (i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = "none";
    }
    tablinks = document.getElementsByClassName("tablinks");
    for (i = 0; i < tablinks.length; i++) {
      tablinks[i].className = tablinks[i].className.replace(" active", "");
    }
    document.getElementById(tabName).style.display = "block";
    evt.currentTarget.className += " active";
  }
  
  document.getElementById("defaultOpen").click();
</script>